+    // Iris: in 12-hour format always print AM/PM in Latin script, whatever the
+    // locale. Qt takes "AP" from LC_TIME's CLDR data (e.g. tr_TR: ÖÖ/ÖS) and
+    // there is no separate setting for it, so the output is translated here.
+    function latinAmPm(text: string): string {
+        const locale = Qt.locale();
+        return text.replace(locale.amText, "AM").replace(locale.pmText, "PM");
